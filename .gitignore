__pycache__/
*.pyc
.vscode/
compile_commands.json
.cache/
.claude/

# ESP-IDF build output. One directory per App (see CMakeLists.txt).
build/
# ccache, when CCACHE_DIR is redirected here (CI does; locally it defaults to
# the user cache dir and never appears in the tree).
.ccache/
# Dead PlatformIO build cache from before the IDF 6 migration. Still ignored so
# a checkout that predates it stays quiet; safe to delete.
.pio/

# Generated from the tracked sdkconfig.defaults on every configure. The argfiles
# put it in build/<app>/ so nothing is shared between Apps; these two catch a
# bare `idf.py` invoked without one, which writes to the project root. Note the
# leading slashes: sdkconfig.defaults IS tracked and must not be caught here.
/sdkconfig
/sdkconfig.old

# Generated by a bare `idf.py` run inside the mbedTLS perf spike, which has its
# own sdkconfig.defaults and its own argfiles (spike/mbedtls-perf/).
/spike/*/sdkconfig
/spike/*/sdkconfig.old

# Fetched by the IDF component manager from main/idf_component.yml.
managed_components/

# Cloned by components/lovyangfx/CMakeLists.txt at configure time.
components/lovyangfx/upstream/

# Assembled from html/ by scripts/pack_fs.py, one per App.
data-*/
